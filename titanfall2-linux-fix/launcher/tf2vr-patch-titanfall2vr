#!/usr/bin/env python3
r"""Patch Titanfall2VR.dll: multiplayer models must not fastfail, cockpit HUD must stay.

The plugin derives its first-person rig parameters from model names it knows
by heart, and only ever knows the campaign ones:

  * pilot hand model  -> pov_mlt_hero_jack_rifleman.mdl / pov_mlt_hero_jack.mdl
                         / pov_mlt_hero_jack_st.mdl
  * seated (in-titan) pilot model -> weapons/arms/pov_mlt_hero_jack.mdl

Anything else - every multiplayer pilot, every MP titan's seated arms - fails a
check and dies with 0xC0000409, printing

    Titanfall2VR: unrecognized pilot hand model
    Titanfall2VR: seated pilot model changed

Three independent mechanisms are patched:

1. The hand-model path loads the message with `lea rcx,[rip+...]`, prints it
   through an indirect call and then executes `mov ecx,7 / int 0x29` inline.
   Two such sites exist.  NOP the `int 0x29` and the code falls through to the
   same registers it loads for pov_mlt_hero_jack.mdl, so an unknown model is
   posed with the campaign rig instead of killing the game.

2. The seated model and every other invariant in the binary ("seated bone
   setup failed", "hidden bones have no parent", ...) funnel into one shared
   helper that takes a bool in cl and a message in rdx, prints the message when
   cl is clear and only then fastfails.  The call site computes cl with `sete
   cl` after comparing against the campaign model name.  NOP the helper's
   `int 0x29` and it prints its warning and returns: the helper's own
   `push rbx / sub rsp,0x20` prologue is unwound by the `add rsp,0x20 / pop rbx
   / ret` epilogue that follows the fastfail, so falling through is balanced.

3. The cockpit HUD's weapon panel is faded out by a per-frame state machine
   held in the plugin's global UI state (weapon_hud_alpha).  It keeps the panel
   visible for a 3 s grace period after the gun leaves the hand, then ramps the
    alpha down over 0.25 s, and ramps it back up over 0.15 s on redraw.  With a
    VR headset on, a holstered gun means the whole panel vanishes and only comes
    back when you draw again, which reads as a broken HUD.  The branch that
    accumulates the grace timer is selected by `test cl,cl / je`; cl is only
    ever read there.  NOP the `je` so the fade-in arm is taken unconditionally:
    weapon_hud_alpha then lerps to 1.0 and stays, while the cinematic / menu /
    loading gates that hide the HUD for real are untouched.

Everything else - the hundreds of compiler-generated buffer-security fastfails -
is left alone.  Each site is guarded by its message string, the RIP-relative
reference to it and the exact surrounding bytes, so a different plugin build is
skipped rather than corrupted.  A pre-edit copy is kept next to the file as
*.orig-tf2vr.

Usage: tf2vr-patch-titanfall2vr [-n] [-r]   (-n dry run, -r revert)
"""

import glob
import os
import stat
import struct
import sys

MSG = b"unrecognized pilot hand model\x00"
LEA = b"\x48\x8d\x0d"                      # lea rcx,[rip+rel32]
CALL = b"\xff\x15"                          # call qword [rip+rel32]
FASTFAIL = b"\xb9\x07\x00\x00\x00\xcd\x29"  # mov ecx,7 ; int 0x29
NOPPED = b"\xb9\x07\x00\x00\x00\x90\x90"    # mov ecx,7 ; nop ; nop
INT29 = 5                                   # offset of int 0x29 inside FASTFAIL

SEATED_MSG = b"seated pilot model changed\x00"
LEA_RDX = b"\x48\x8d\x15"                   # lea rdx,[rip+rel32]
SETE_CL = b"\x0f\x94\xc1"                   # sete cl
CALL_REL = b"\xe8"                          # call rel32 (thunk into the helper)
JMP_REL = b"\xe9"                           # jmp rel32 (thunk tail)
GUARD = b"\x84\xc9\x75"                     # test cl,cl ; jne (helper prologue)
EPILOGUE = b"\x48\x83\xc4\x20\x5b\xc3"      # add rsp,0x20 ; pop rbx ; ret

FF_OLD = b"\xcd\x29"                        # int 0x29
FF_NEW = b"\x90\x90"                        # nop ; nop

# Cockpit HUD fade:  test <reg>,<reg> ; je <grace timer arm>
# 1.0.7 tested dl, 1.0.8 tests cl; everything after the gate is identified
# semantically instead of by absolute address, so either build is accepted.
HUD_GATES = [
    (b"\x84\xd2\x74\x2c", b"\x84\xd2\x90\x90"),   # test dl,dl ; je +0x2c
    (b"\x84\xc9\x74\x2c", b"\x84\xc9\x90\x90"),   # test cl,cl ; je +0x2c
]
GRACE = b"\xc7\x05"                         # movl imm32,[rip+disp32]
FADEIN = b"\xf3\x44\x0f\x5e"                # divss xmm12,<operand>
RIP_MASK = 0xC7                             # modrm & RIP_MASK == 0x05 -> [rip+d32]
FADEIN_CONST = 0.15                         # seconds to ramp alpha back to 1.0
ALPHA_1_0 = b"\x00\x00\x80\x3f"             # weapon_hud_alpha reset value

CANDIDATES = [
    os.path.expanduser("~/.local/share/Steam/steamapps/common/*/TF2VR/plugins/Titanfall2VR.dll"),
    os.path.expanduser("~/.steam/root/steamapps/common/*/TF2VR/plugins/Titanfall2VR.dll"),
    os.path.expanduser("~/Steam/steamapps/common/*/TF2VR/plugins/Titanfall2VR.dll"),
]
if os.environ.get("STEAM_DIR"):
    CANDIDATES.insert(0, os.path.join(os.environ["STEAM_DIR"],
                                      "steamapps/common/*/TF2VR/plugins/Titanfall2VR.dll"))


def sections(data):
    """Return [(rva, virtual_size, raw_offset, raw_size)] for a PE image."""
    pe = struct.unpack_from("<I", data, 0x3C)[0]
    if data[pe:pe + 4] != b"PE\x00\x00":
        return None
    nsec = struct.unpack_from("<H", data, pe + 6)[0]
    opt = struct.unpack_from("<H", data, pe + 20)[0]
    base = pe + 24 + opt
    out = []
    for i in range(nsec):
        o = base + i * 40
        vsz, va, rsz, ro = struct.unpack_from("<IIII", data, o + 8)
        out.append((va, vsz, ro, rsz))
    return out


def sites(data):
    """[(file offset, original bytes, patched bytes)] for every site we own,
    or None if this is not a plugin build we recognise."""
    secs = sections(data)
    if not secs:
        return None

    def off_to_rva(off):
        for va, _vsz, ro, rsz in secs:
            if ro <= off < ro + rsz:
                return va + (off - ro)
        return None

    def rva_to_off(rva):
        for va, vsz, ro, _rsz in secs:
            if va <= rva < va + max(vsz, 1):
                return ro + (rva - va)
        return None

    found = []
    msg = data.find(MSG)
    if msg < 0:
        return None
    msg_rva = off_to_rva(msg)
    if msg_rva is None:
        return None

    i = 0
    while True:
        i = data.find(LEA, i)
        if i < 0:
            break
        rva = off_to_rva(i)
        if rva is not None:
            rel = struct.unpack_from("<i", data, i + 3)[0]
            if rva + 7 + rel == msg_rva:
                head = i + len(LEA) + 4          # call qword [rip+...]
                tail = data[head:head + len(CALL) + 4 + len(FASTFAIL)]
                if (not tail.startswith(CALL)
                        or tail[len(CALL) + 4:] not in (FASTFAIL, NOPPED)):
                    return None  # unexpected layout, do not guess
                found.append((head + len(CALL) + 4 + INT29, FF_OLD, FF_NEW))
        i += 1
    if not found:
        return None

    helper = _helper_fastfail(data, SEATED_MSG, off_to_rva, rva_to_off)
    if helper is None:
        return None
    found.append((helper, FF_OLD, FF_NEW))

    hud = _hud_fade(data, off_to_rva, rva_to_off)
    if hud is None:
        return None
    found.append(hud)
    return found


def _hud_fade(data, off_to_rva, rva_to_off):
    """(offset, original, patched) for the cockpit HUD fade branch.

    Located structurally rather than by a message string: find the `je` that
    picks the holster-grace arm, then insist that the instructions it guards are
    the ones that reset the 3 s grace timer and divide the frame delta by the
    0.15 s fade-in constant, and that the same function writes 1.0 back into
    weapon_hud_alpha.  Absolute addresses move between builds, so only the
    shape of the code and the constants it uses are checked.
    """
    def rip_target(at, prefix, total):
        """Absolute VA of a rip-relative operand at `at` (prefix..disp32)."""
        rva = off_to_rva(at)
        if rva is None:
            return None
        disp = struct.unpack_from("<i", data, at + prefix)[0]
        return 0x180000000 + rva + total + disp

    def float_at(va):
        if va is None:
            return None
        off = rva_to_off(va - 0x180000000)
        if off is None or off + 4 > len(data):
            return None
        return struct.unpack_from("<f", data, off)[0]

    def guards(i):
        grace = i + 4                               # past test <reg>,<reg> ; je
        if data[grace:grace + len(GRACE)] != GRACE:
            return False
        grace_va = rip_target(grace, len(GRACE), 10)
        if grace_va is None:
            return False

        fadein = grace + 10                         # movl imm32,[rip+d32] is 10 B
        if data[fadein:fadein + len(FADEIN)] != FADEIN:
            return False
        if data[fadein + len(FADEIN)] & RIP_MASK != 0x05:
            return False
        const = float_at(rip_target(fadein, len(FADEIN) + 1, 9))
        if const is None or abs(const - FADEIN_CONST) > 1e-6:
            return False

        # the reset arm must store 1.0 into weapon_hud_alpha, i.e. grace + 4
        window = data[i:i + 0x180]
        hit = window.find(GRACE)
        while hit >= 0:
            if window[hit + 6:hit + 10] == ALPHA_1_0:
                rva = off_to_rva(i + hit)
                if rva is not None:
                    disp = struct.unpack_from("<i", window, hit + 2)[0]
                    if 0x180000000 + rva + 10 + disp == grace_va + 4:
                        return True
            hit = window.find(GRACE, hit + 1)
        return False

    found = []
    for original, patched in HUD_GATES:
        for variant in (original, patched):     # accept our own edit too
            i = data.find(variant)
            while i >= 0:
                if guards(i):
                    found.append((i, original, patched))
                i = data.find(variant, i + 1)
    found.sort()
    found = [f for n, f in enumerate(found) if n == 0 or found[n - 1] != f]
    if len(found) != 1:
        return None
    i, original, patched = found[0]
    return (i + 2, original[2:], patched[2:])


def _helper_fastfail(data, message, off_to_rva, rva_to_off):
    """Offset of the shared invariant helper's `int 0x29`.

    Follows message string -> `lea rdx,[rip+message]` -> `sete cl` ->
    `call` thunk -> thunk target -> `test cl,cl` prologue -> fastfail, and
    only accepts the site when the helper's own epilogue follows it.
    """
    msg = data.find(message)
    if msg < 0:
        return None
    msg_rva = off_to_rva(msg)
    if msg_rva is None:
        return None

    lea = None
    i = 0
    while True:
        i = data.find(LEA_RDX, i)
        if i < 0:
            break
        rva = off_to_rva(i)
        if rva is not None:
            rel = struct.unpack_from("<i", data, i + 3)[0]
            if rva + 7 + rel == msg_rva:
                lea = i
                break
        i += 1
    if lea is None or data[lea - len(SETE_CL):lea] != SETE_CL:
        return None

    call = lea + len(LEA_RDX) + 4                # rel32 tail of the lea
    if data[call:call + 1] != CALL_REL:
        return None
    target = off_to_rva(call) + 5 + struct.unpack_from("<i", data, call + 1)[0]

    for _ in range(4):                          # resolve jmp thunks
        off = rva_to_off(target)
        if off is None:
            return None
        if data[off:off + 1] != JMP_REL:
            break
        target = target + 5 + struct.unpack_from("<i", data, off + 1)[0]
    else:
        return None

    fn = rva_to_off(target)
    if fn is None or data[fn:fn + len(GUARD)] != GUARD:
        return None

    window = data[fn:fn + 0x80]
    for kind in (FASTFAIL, NOPPED):
        hit = window.find(kind)
        while hit >= 0:
            end = hit + len(kind)
            if window[end:end + len(EPILOGUE)] == EPILOGUE:
                return fn + hit + INT29
            hit = window.find(kind, hit + 1)
    return None


def _write(path, content):
    mode = os.stat(path).st_mode
    os.chmod(path, mode | stat.S_IWUSR)
    try:
        with open(path, "wb") as fh:
            fh.write(content)
    finally:
        os.chmod(path, mode)


def handle(path, dry, revert):
    with open(path, "rb") as fh:
        data = fh.read()
    backup = path + ".orig-tf2vr"

    offs = sites(data)
    if offs is None:
        return "different plugin build (expected fastfail sites not found), skipped: " + path

    if revert:
        if not os.path.exists(backup):
            return "no backup to revert: " + path
        with open(backup, "rb") as fh:
            original = fh.read()
        if data == original:
            return "already reverted: " + path
        if sites(original) is None:
            return "backup is not a matching build, left alone: " + path
        if dry:
            return "would revert: " + path
        _write(path, original)
        return "reverted: " + path

    todo = [s for s in offs if data[s[0]:s[0] + len(s[1])] == s[1]]
    if not todo:
        if all(data[s[0]:s[0] + len(s[2])] == s[2] for s in offs):
            return "already patched: " + path
        return "unexpected bytes at a patch site, skipped: " + path
    if dry:
        return "would patch: %s (%d of %d site(s))" % (path, len(todo), len(offs))

    patched = bytearray(data)
    for o, _old, new in todo:
        patched[o:o + len(new)] = new
    if not os.path.exists(backup):
        with open(backup, "wb") as fh:
            fh.write(data)
    _write(path, bytes(patched))
    return "patched: %s (%d site(s))" % (path, len(todo))


def main():
    args = sys.argv[1:]
    dry = "-n" in args or "--dry-run" in args
    revert = "-r" in args or "--revert" in args
    explicit = [a for a in args if not a.startswith("-")]
    paths = explicit or sorted({os.path.realpath(p)
                                for pat in CANDIDATES for p in glob.glob(pat)})

    if not paths:
        print("tf2vr-patch-titanfall2vr: no Titanfall2VR.dll found", file=sys.stderr)
        return 1

    changed = 0
    for path in paths:
        try:
            msg = handle(path, dry, revert)
        except OSError as exc:
            msg = "cannot read %s: %s" % (path, exc)
        print("  " + msg)
        if msg.startswith(("patched", "would patch", "reverted", "would revert")):
            changed += 1
    verb = "reverted" if revert else "patched"
    print("tf2vr-patch-titanfall2vr: %d file(s) %s%s of %d checked"
          % (changed, "would be " if dry else "", verb, len(paths)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
