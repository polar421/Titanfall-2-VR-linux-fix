// ---------------------------------------------------------------------------
// Pickup reachability, ported from tf2vr_pickups.gnut.  Shared because the
// server validates "cmd tf2vr_pickup" with it and the client picks targets
// with it.

vector function TF2VR_MP_PickupPoint( entity weapon, vector hand )
{
	vector origin = weapon.GetOrigin()
	vector delta = hand - origin
	vector mins = weapon.GetBoundingMins()
	vector maxs = weapon.GetBoundingMaxs()
	return origin + <clamp( delta.x, mins.x, maxs.x ), clamp( delta.y, mins.y, maxs.y ), clamp( delta.z, mins.z, maxs.z )>
}

bool function TF2VR_MP_PickupInReach( vector point, vector hand, vector forward )
{
	float along = DotProduct( point - hand, forward )
	vector center = hand + forward * along
	float radius = TF2VR_MP_PICKUP_RADIUS + ( TF2VR_MP_PICKUP_TIP_RADIUS - TF2VR_MP_PICKUP_RADIUS ) * along / TF2VR_MP_PICKUP_EXTENSION
	bool nearby = DistanceSqr( hand, point ) <= TF2VR_MP_PICKUP_RADIUS * TF2VR_MP_PICKUP_RADIUS
	bool inCone = along >= 0.0 && along <= TF2VR_MP_PICKUP_EXTENSION && DistanceSqr( center, point ) <= radius * radius
	return nearby || inCone
}

bool function TF2VR_MP_PickupClear( entity player, entity weapon, vector hand, vector point )
{
	TraceResults reach = TraceLine( player.EyePosition(), hand, [ player, weapon ], TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
	TraceResults touch = TraceLine( hand, point, [ player, weapon ], TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
	return !reach.startSolid && reach.fraction == 1.0 && !touch.startSolid && touch.fraction == 1.0
}

bool function TF2VR_MP_PickupReachable( entity player, entity weapon, vector hand, vector forward )
{
	vector point = TF2VR_MP_PickupPoint( weapon, hand )
	return TF2VR_MP_PickupInReach( point, hand, forward ) && TF2VR_MP_PickupClear( player, weapon, hand, point )
}

// ---------------------------------------------------------------------------
// Grenade throwing.  The plugin detects the hand throw, sends
// "cmd tf2vr_grenade <ticket>" to the server to arm one, then calls this on
// both VMs; this is where the ordnance is actually created.  Leaving it empty
// is what made every grenade and tick in multiplayer unfirable.

void function TF2VR_PredictGrenade( int ticket, int consumesAmmo, vector position, vector angles, vector velocity, vector spin )
{
	printt( "TF2VRMP[predict] ticket=" + ticket + " consumesAmmo=" + consumesAmmo )
	#if SERVER
		array<entity> players = GetPlayerArray()
		if ( players.len() == 0 )
			return
		entity player = players[0]
		if ( !IsValid( file.grenade ) || ticket != file.grenadeTicket || ( consumesAmmo != 0 ) != file.grenadeConsumesAmmo )
			return
		entity weapon = file.grenade
		bool launch = true
	#else
	#if CLIENT
		entity player = GetLocalViewPlayer()
		if ( !IsValid( player ) )
			return
		entity weapon = player.GetOffhandWeapon( OFFHAND_ORDNANCE )
		if ( !IsValid( weapon ) )
			return
		bool launch = weapon.ShouldPredictProjectiles()
	#else
		return
	#endif
	#endif

	int cost = weapon.GetWeaponSettingInt( eWeaponVar.ammo_per_shot )
	if ( weapon.GetWeaponPrimaryClipCount() < cost )
		return

	weapon.AddMod( "tf2vr_throw" )
	if ( launch )
	{
		int damage = weapon.GetWeaponDamageFlags()
		entity grenade = weapon.FireWeaponGrenade( position, AnglesToForward( angles ), spin, weapon.GetGrenadeFuseTime(), damage, damage, true, false, true )
		if ( !IsValid( grenade ) )
			return
		grenade.SetScriptName( "tf2vr_thrown_grenade" )
		grenade.SetAngles( angles )
		grenade.SetVelocity( velocity )
		#if SERVER
			Grenade_OnPlayerNPCTossGrenade_Common( weapon, grenade )
			file.grenadeTicket = 0
		#else
		#if CLIENT
			Grenade_Init( grenade, weapon )
			SetConVarInt( "tf2vr_projectile_entity", grenade.GetEntIndex() )
			SetConVarInt( "tf2vr_projectile_ticket", ticket )
		#endif
		#endif
		weapon.EmitWeaponSound_1p3p( GetGrenadeDeploySound_1p( weapon ), GetGrenadeDeploySound_3p( weapon ) )
		weapon.EmitWeaponSound_1p3p( GetGrenadeThrowSound_1p( weapon ), GetGrenadeThrowSound_3p( weapon ) )
	}
	if ( consumesAmmo != 0 )
	{
		int left = weapon.GetWeaponPrimaryClipCount() - cost
		weapon.SetWeaponPrimaryClipCount( left > 0 ? left : 0 )
	}
	PlayerUsedOffhand( player, weapon )
}

// ---------------------------------------------------------------------------
// Client side: which guns and grenades the player is carrying, and which world
// weapon each hand is currently pointing at.

void function TF2VR_MP_PickupCreated( entity weapon )
{
	file.weapons.append( weapon )
}

void function TF2VR_MP_PickupDestroyed( entity weapon )
{
	file.weapons.fastremovebyvalue( weapon )
}

// Ported from tf2vr_pickups.gnut.  The plugin reads tf2vr_holster_mask every
// frame to decide which hip holsters exist and which gun is available to draw;
// with this left empty the mask never left 0 and multiplayer spawned with no
// weapon in hand and no ordnance to throw.
void function TF2VR_UpdatePickups( int mask, vector left, vector right, vector leftForward, vector rightForward, vector leftHip, vector rightHip, vector hipForward )
{
	#if CLIENT
		entity player = GetLocalViewPlayer()
		file.targets = [ null, null ]

		int holsters = 0
		if ( IsValid( player ) )
		{
			foreach ( entity weapon in player.GetMainWeapons() )
			{
				if ( !TF2VR_EmptyHands( weapon ) )
					holsters = holsters | ( 1 << TF2VR_GunSlot( weapon ) )
			}
			entity ordnance = player.GetOffhandWeapon( OFFHAND_ORDNANCE )
			if ( TF2VR_Throwable( ordnance ) && ordnance.GetWeaponPrimaryClipCount() >= ordnance.GetWeaponSettingInt( eWeaponVar.ammo_per_shot ) )
				holsters = holsters | ( 1 << TF2VR_MP_GRENADE_HOLSTER )
		}
		SetConVarInt( "tf2vr_holster_mask", holsters )

		// SP always arrives with tf2vr_gun_name / tf2vr_gun_slot already filled
		// by an earlier "cmd tf2vr_draw"; on MP nothing has drawn yet, so seed
		// them once from whatever the player is actually holding.
		if ( IsValid( player ) && GetConVarString( "tf2vr_gun_name" ) == "" )
		{
			entity active = player.GetActiveWeapon()
			if ( IsValid( active ) && !TF2VR_EmptyHands( active ) && active.GetWeaponClassName() != "" )
			{
				SetConVarString( "tf2vr_gun_name", active.GetWeaponClassName() )
				SetConVarInt( "tf2vr_gun_slot", TF2VR_GunSlot( active ) )
			}
		}

		if ( IsValid( player ) && IsAlive( player ) && !player.IsTitan() && !player.ContextAction_IsActive() && !player.IsWeaponDisabled() )
		{
			array<vector> hands = [ left, right ]
			array<vector> forwards = [ Normalize( leftForward ), Normalize( rightForward ) ]
			float reachSqr = TF2VR_MP_PICKUP_EXTENSION * TF2VR_MP_PICKUP_EXTENSION + TF2VR_MP_PICKUP_TIP_RADIUS * TF2VR_MP_PICKUP_TIP_RADIUS
			array<float> beams = [ reachSqr, reachSqr ]

			foreach ( entity weapon in file.weapons )
			{
				int kind = TF2VR_PickupKind( weapon )
				if ( kind == -1 || IsValid( weapon.GetWeaponOwner() ) )
					continue
				foreach ( int side, vector hand in hands )
				{
					if ( !( mask & ( 1 << ( side + kind * 2 ) ) ) )
						continue
					vector point = TF2VR_MP_PickupPoint( weapon, hand )
					float along = DotProduct( point - hand, forwards[side] )
					float beam = DistanceSqr( point, hand + forwards[side] * max( along, 0.0 ) )
					if ( beam > beams[side] || !TF2VR_MP_PickupReachable( player, weapon, hand, forwards[side] ) )
						continue
					beams[side] = beam
					file.targets[side] = weapon
				}
			}
		}

		foreach ( int side, string suffix in [ "left", "right" ] )
		{
			entity target = file.targets[side]
			SetConVarInt( "tf2vr_pickup_" + suffix, IsValid( target ) ? target.GetEntIndex() : -1 )
			SetConVarInt( "tf2vr_pickup_kind_" + suffix, IsValid( target ) ? TF2VR_PickupKind( target ) : -1 )
		}

		file.pickupCalls++
		int t0 = IsValid( file.targets[0] ) ? file.targets[0].GetEntIndex() : -1
		int t1 = IsValid( file.targets[1] ) ? file.targets[1].GetEntIndex() : -1
		bool changed = holsters != file.lastMask || t0 != file.lastTarget0 || t1 != file.lastTarget1
		if ( changed )
		{
			file.lastMask = holsters
			file.lastTarget0 = t0
			file.lastTarget1 = t1
		}
		if ( file.pickupCalls <= 3 || changed || ( file.pickupCalls % 600 ) == 0 )
		{
			string mains = ""
			string active = "none"
			string ordnance = "none"
			if ( IsValid( player ) )
			{
				foreach ( entity weapon in player.GetMainWeapons() )
					mains += weapon.GetWeaponClassName() + "(" + TF2VR_GunSlot( weapon ) + ") "
				if ( IsValid( player.GetActiveWeapon() ) )
					active = player.GetActiveWeapon().GetWeaponClassName()
				entity offhand = player.GetOffhandWeapon( OFFHAND_ORDNANCE )
				if ( IsValid( offhand ) )
					ordnance = offhand.GetWeaponClassName()
			}
			printt( "TF2VRMP[pickups] n=" + file.pickupCalls + " changed=" + changed +
				" inmask=" + mask + " holster=" + holsters +
				" gun=" + GetConVarString( "tf2vr_gun_name" ) + " slot=" + GetConVarInt( "tf2vr_gun_slot" ) +
				" active=" + active + " ord=" + ordnance +
				" mains=" + mains + " tgt=" + t0 + "," + t1 + " worldwpns=" + file.weapons.len() )
		}
	#endif
}

// ---------------------------------------------------------------------------
// Server side: the client commands the plugin issues to draw, grab and throw.

#if SERVER

void function TF2VR_MP_EquipGun( entity player, entity weapon, int ticket )
{
	player.HolsterWeapon()
	player.SetActiveWeaponByName( weapon.GetWeaponClassName() )
	player.DeployWeapon()
	SetConVarString( "tf2vr_gun_name", weapon.GetWeaponClassName() )
	SetConVarInt( "tf2vr_gun_slot", TF2VR_GunSlot( weapon ) )
	SetConVarInt( "tf2vr_gun_ack", ticket )
}

void function TF2VR_MP_PlayGrenadePickupSound( entity player )
{
	EmitSoundOnEntityOnlyToPlayer( player, player, "Pilot_Mvmt_Boost_Card_Activate_Cloth_Arm_Raise_1P" )
}

void function TF2VR_MP_HoldGrenade( entity player, entity weapon, int ticket, bool consumesAmmo )
{
	file.grenade = weapon
	file.grenadeTicket = ticket
	file.grenadeConsumesAmmo = consumesAmmo
	SetConVarInt( "tf2vr_grenade_consumes_ammo", consumesAmmo ? 1 : 0 )
	TF2VR_MP_PlayGrenadePickupSound( player )
	SetConVarInt( "tf2vr_grenade_ack", ticket )
}

bool function TF2VR_MP_Draw( entity player, array<string> args )
{
	if ( args.len() != 2 )
	{
		printt( "TF2VRMP[draw] BADARGS len=" + args.len() )
		return true
	}
	int ticket = args[0].tointeger()
	int slot = args[1].tointeger()
	if ( slot != 0 && slot != 1 && slot != TF2VR_MP_ARC_TOOL_HOLSTER )
	{
		printt( "TF2VRMP[draw] BADSLOT slot=" + slot + " ticket=" + ticket )
		return true
	}
	SetConVarInt( "tf2vr_gun_ack", -ticket )
	if ( !IsAlive( player ) || player.IsTitan() || player.ContextAction_IsActive() )
	{
		printt( "TF2VRMP[draw] REFUSED slot=" + slot + " ticket=" + ticket + " alive=" + IsAlive( player ) + " titan=" + player.IsTitan() )
		return true
	}
	foreach ( entity weapon in player.GetMainWeapons() )
	{
		if ( TF2VR_GunSlot( weapon ) != slot )
			continue
		TF2VR_MP_EquipGun( player, weapon, ticket )
		if ( slot == 0 )
			FlagSet( "TF2VR_DrewPrimary" )
		if ( slot == 1 )
			FlagSet( "TF2VR_DrewSecondary" )
		printt( "TF2VRMP[draw] OK slot=" + slot + " ticket=" + ticket + " gun=" + weapon.GetWeaponClassName() )
		return true
	}
	printt( "TF2VRMP[draw] NOMATCH slot=" + slot + " ticket=" + ticket )
	return true
}

bool function TF2VR_MP_GrabGrenade( entity player, array<string> args )
{
	if ( args.len() != 1 )
	{
		printt( "TF2VRMP[grenade] BADARGS len=" + args.len() )
		return true
	}
	int ticket = args[0].tointeger()
	SetConVarInt( "tf2vr_grenade_ack", -ticket )
	printt( "TF2VRMP[grenade] arrived ticket=" + ticket + " alive=" + IsAlive( player ) + " titan=" + player.IsTitan() )
	if ( !IsAlive( player ) || player.IsTitan() || player.ContextAction_IsActive() || player.IsWeaponDisabled() )
		return true
	entity weapon = player.GetOffhandWeapon( OFFHAND_ORDNANCE )
	if ( !TF2VR_Throwable( weapon ) || weapon.GetWeaponPrimaryClipCount() < weapon.GetWeaponSettingInt( eWeaponVar.ammo_per_shot ) )
		return true
	TF2VR_MP_HoldGrenade( player, weapon, ticket, true )
	return true
}

bool function TF2VR_MP_CancelGrenade( entity player, array<string> args )
{
	if ( args.len() == 1 && args[0].tointeger() == file.grenadeTicket )
		file.grenadeTicket = 0
	return true
}

bool function TF2VR_MP_StoreGrenade( entity player, array<string> args )
{
	if ( args.len() == 1 && args[0].tointeger() == file.grenadeTicket )
	{
		file.grenadeTicket = 0
		TF2VR_MP_PlayGrenadePickupSound( player )
	}
	return true
}

// Mirrors tf2vr_pickups.gnut: hands and hips are in inches, and a grab only
// lands when the server can trace a clear line to it.
bool function TF2VR_MP_Pickup( entity player, array<string> args )
{
	if ( args.len() != 9 )
		return true
	int ticket = args[0].tointeger()
	int kind = args[2].tointeger()
	if ( kind != 0 && kind != 1 )
		return true
	string ack = kind == 0 ? "tf2vr_gun_ack" : "tf2vr_grenade_ack"
	SetConVarInt( ack, -ticket )
	if ( !IsAlive( player ) || player.IsTitan() || player.ContextAction_IsActive() || player.IsWeaponDisabled() )
		return true
	entity weapon = GetEntByIndex( args[1].tointeger() )
	if ( !IsValid( weapon ) || TF2VR_PickupKind( weapon ) != kind || IsValid( weapon.GetWeaponOwner() ) )
		return true
	if ( kind == 1 && weapon.GetWeaponPrimaryClipCount() < weapon.GetWeaponSettingInt( eWeaponVar.ammo_per_shot ) )
		return true
	vector hand = <args[3].tofloat(), args[4].tofloat(), args[5].tofloat()>
	vector forward = Normalize( <args[6].tofloat(), args[7].tofloat(), args[8].tofloat()> )
	if ( !TF2VR_MP_PickupReachable( player, weapon, hand, forward ) )
		return true

	string name = weapon.GetWeaponClassName()
	if ( kind == 1 )
	{
		entity ordnance = player.GetOffhandWeapon( OFFHAND_ORDNANCE )
		if ( IsValid( ordnance ) && ordnance.GetWeaponClassName() == name )
		{
			int count = ordnance.GetWeaponPrimaryClipCount()
			int maximum = ordnance.GetWeaponPrimaryClipCountMax()
			int cost = ordnance.GetWeaponSettingInt( eWeaponVar.ammo_per_shot )
			bool consumesAmmo = count < maximum
			if ( consumesAmmo )
				ordnance.SetWeaponPrimaryClipCount( minint( count + cost, maximum ) )
			weapon.Destroy()
			TF2VR_MP_HoldGrenade( player, ordnance, ticket, consumesAmmo )
			return true
		}
	}
	else
	{
		foreach ( entity owned in player.GetMainWeapons() )
		{
			if ( owned.GetWeaponClassName() != name )
				continue
			TF2VR_MP_EquipGun( player, owned, ticket )
			return true
		}
	}

	player.ForceUseEntity( weapon )
	if ( kind == 1 )
	{
		entity ordnance = player.GetOffhandWeapon( OFFHAND_ORDNANCE )
		if ( IsValid( ordnance ) && ordnance.GetWeaponClassName() == name )
		{
			int cost = ordnance.GetWeaponSettingInt( eWeaponVar.ammo_per_shot )
			ordnance.SetWeaponPrimaryClipCount( cost )
			TF2VR_MP_HoldGrenade( player, ordnance, ticket, true )
		}
	}
	else
	{
		FlagSet( "TF2VR_PickedUpGun" )
		entity equipped = player.GetActiveWeapon()
		if ( IsValid( equipped ) && equipped.GetWeaponClassName() == name )
			TF2VR_MP_EquipGun( player, equipped, ticket )
	}
	return true
}

#endif

// Registered from both VMs: the server arms the client commands the plugin
// sends, the client watches the ground for weapons it can pick up.  Both
// halves are separately guarded so this compiles in any VM Northstar puts it
// in, and stays empty where the calls do not exist.
void function TF2VR_MPInit()
{
	#if SERVER
		// Same two things SP's TF2VR_PickupsInit does: stop the game auto-
		// swapping ordnance when it tops up, and arm the client commands the
		// plugin issues to draw, grab and throw.
		SetConVarInt( "weapon_auto_swap_ordnance_no_ammo", 0 )
		FlagInit( "TF2VR_PickedUpGun" )
		FlagInit( "TF2VR_DrewPrimary" )
		FlagInit( "TF2VR_DrewSecondary" )
		AddClientCommandCallback( "tf2vr_draw", TF2VR_MP_Draw )
		AddClientCommandCallback( "tf2vr_pickup", TF2VR_MP_Pickup )
		AddClientCommandCallback( "tf2vr_grenade", TF2VR_MP_GrabGrenade )
		AddClientCommandCallback( "tf2vr_cancel_grenade", TF2VR_MP_CancelGrenade )
		AddClientCommandCallback( "tf2vr_store_grenade", TF2VR_MP_StoreGrenade )
		printt( "TF2VRMP[init-server] tf2vr_draw/pickup/grenade/cancel/store registered" )
	#endif
	#if CLIENT
		// SP's TF2VR_InteractionsInit sets these before the plugin starts
		// reading them; without the transition mask the plugin has no idea
		// embark/disembark is in progress and can drop the held weapon.
		AddCreateCallback( "weaponx", TF2VR_MP_PickupCreated )
		AddDestroyCallback( "weaponx", TF2VR_MP_PickupDestroyed )
		SetConVarInt( "tf2vr_utility_entity", 0 )
		SetConVarInt( "tf2vr_reload_highlight_entity", 0 )
		SetConVarInt( "tf2vr_titan_transition_mask", CE_FLAG_EMBARK | CE_FLAG_DISEMBARK )
		printt( "TF2VRMP[init-client] weaponx callbacks registered, transition_mask=" + GetConVarInt( "tf2vr_titan_transition_mask" ) )
	#endif
}

#endif // SERVER || CLIENT
