untyped

// Upstream gates every VR gameplay script in Titanfall2VR.Cockpit with
// "RunOn": "SP", but a dozen of Cockpit's other scripts compile ungated on MP.
// Those call back into the SP files for shared helpers, and Titanfall2VR.dll
// resolves a second set by name at runtime, so on mp_* levels both the script
// VM and the plugin come up short:
//
//   compile time (script VM aborts with "Encountered CLIENT script
//   compilation error"; the compiler stops at the first undefined name, so
//   these surfaced one at a time)
//
//     sh_codecallbacks.gnut:97     TF2VR_PickupKind        SERVER || CLIENT
//     sh_highlight.gnut:975        TF2VR_PickupKind        SERVER || CLIENT
//     sh_highlight.gnut:1505       TF2VR_IsPickupTarget    SERVER || CLIENT
//     _utility.gnut:3038           TF2VR_PickupKind        SERVER
//     weapons/_vortex.nut          TF2VR_Vortex*           SERVER || CLIENT
//     weapons/mp_titanweapon_heat_shield.nut  TF2VR_Vortex*
//     weapons/mp_titancore_salvo_core.nut     TF2VR_TitanView*
//     client/rui/cl_weapon_status.gnut        TF2VR_EmptyHands, TF2VR_TitanKeyHint
//     earn_meter/cl_earn_meter.gnut           TF2VR_TitanKeyHint
//
//   runtime (plugin does a VM lookup and 0xC0000409s when it misses)
//
//     TF2VR_UpdatePickups   holster/pickup state, drives tf2vr_holster_mask
//     TF2VR_PredictGrenade  performs the hand-thrown grenade
//     TF2VR_UpdateTitanPose titan aim + vortex placement
//     TF2VR_UpdateEmbark / UpdateEyeCase / UpdateBodyMovement /
//     UpdateArcToolPose / PrepareMemory / CheckDynamicMemory
//
// The plugin is a campaign mod: it only knows Jack's models (hence the
// Titanfall2VR.dll patch next to this mod) and it expects the SP glue to exist
// even on mp_* levels.  So this file is not a set of empty stubs - the pieces
// multiplayer actually needs are ported from tf2vr_pickups.gnut,
// tf2vr_interactions.gnut and tf2vr_titan.gnut, with the campaign-only parts
// (SERE eye-case kit, arc tool, BT memories, reload cosmetics) reduced to the
// no-ops they were before.  Everything here is MP-only; the SP originals still
// compile on their own under RunOn "SP".
//
// Northstar requires every "global function" declaration to precede the first
// function definition, so they are collected here.
//
// scripts.rson documents MP as a map-level flag, not a VM one, so a
// "RunOn": "MP" file is also compiled by the UI script VM.  Nothing in the UI
// VM references these names - every caller is SERVER or CLIENT gated - so the
// whole file is wrapped in SERVER || CLIENT and compiles to nothing for the
// menu, which keeps the engine-only globals below (TraceLine, Normalize,
// Grenade_Init, PlayerUsedOffhand, ...) out of the UI API lookup.

#if SERVER || CLIENT

global const int TF2VR_MP_ARC_TOOL_HOLSTER = 3
global const int TF2VR_MP_GRENADE_HOLSTER = 4
global const float TF2VR_MP_PICKUP_RADIUS = 0.15 / 0.0254
const float TF2VR_MP_PICKUP_EXTENSION = 1.0 / 0.0254
const float TF2VR_MP_PICKUP_TIP_RADIUS = 0.40 / 0.0254
const string TF2VR_MP_EMPTY_HANDS = "tf2vr_empty_hands"

global function TF2VR_PickupKind
global function TF2VR_IsPickupTarget
global function TF2VR_VortexControlled
global function TF2VR_VortexOrigin
global function TF2VR_VortexDirection
global function TF2VR_PlaceVortex
global function TF2VR_TitanViewDot
global function TF2VR_TitanViewTrace
global function TF2VR_EmptyHands
global function TF2VR_TitanKeyHint
global function TF2VR_Throwable
global function TF2VR_GunSlot
global function TF2VR_MPInit

global function TF2VR_CheckDynamicMemory
global function TF2VR_PredictGrenade
global function TF2VR_PrepareMemory
global function TF2VR_UpdateArcToolPose
global function TF2VR_UpdateBodyMovement
global function TF2VR_UpdateEmbark
global function TF2VR_UpdateEyeCase
global function TF2VR_UpdatePickups
global function TF2VR_UpdateTitanPose

// Shared by both VMs so nothing has to be #if'd just to reference a member.
struct {
	entity grenade
	int grenadeTicket = 0
	bool grenadeConsumesAmmo = true
	array<entity> weapons
	array<entity> targets = [ null, null ]
	int pickupCalls = 0
	int lastMask = -1
	int lastTarget0 = -999
	int lastTarget1 = -999
} file

// Temporary MP diagnostics: these land in TF2VR/logs/nslog*.txt as
// [SCRIPT CLIENT] / [SCRIPT SERVER] lines prefixed TF2VRMP, so the holster,
// draw and grenade handshakes can be traced without a debugger.

struct {
	entity player
	vector origin
	vector direction
	vector angles
	vector headOrigin
	vector headDirection
} pose

// ---------------------------------------------------------------------------
// Shared helpers, ported from tf2vr_interactions.gnut.

bool function TF2VR_Throwable( entity weapon )
{
	if ( !IsValid( weapon ) )
		return false
	return [ "mp_weapon_frag_grenade", "mp_weapon_grenade_emp", "mp_weapon_grenade_electric_smoke", "mp_weapon_grenade_gravity", "mp_weapon_grenade_sonar", "mp_weapon_thermite_grenade" ].contains( weapon.GetWeaponClassName() )
}

// No charge tool in multiplayer, so the SP special case for CHARGE_TOOL goes
// away and every weapon simply keeps its inventory index.
int function TF2VR_GunSlot( entity weapon )
{
	return weapon.GetInventoryIndex()
}

bool function TF2VR_EmptyHands( entity weapon )
{
	return weapon.GetWeaponClassName() == TF2VR_MP_EMPTY_HANDS
}

int function TF2VR_PickupKind( entity weapon )
{
	if ( weapon.GetClassName() != "weaponx" || weapon.IsLoadoutPickup() || weapon.GetWeaponClass() != "human" )
		return -1
	if ( TF2VR_Throwable( weapon ) )
		return 1
	return weapon.IsWeaponOffhand() ? -1 : 0
}

bool function TF2VR_IsPickupTarget( entity weapon )
{
	return IsValid( weapon ) && !IsValid( weapon.GetWeaponOwner() ) && file.targets.contains( weapon )
}

// Titan ability swipes in offhand slot order, and the HUD key hints that name
// them, are the same on MP as they are in the campaign.
array<string> function TF2VR_MP_TitanGestures()
{
	return [ "up", "forward", "down", "back" ]
}

int function TF2VR_MP_OffhandSlot( string key )
{
	table<string, int> slots = {
		["%offhand0%"] = 0,
		["%offhand1%"] = 1,
		["%offhand2%"] = 2,
		["%offhand3%"] = 3
	}
	return key in slots ? slots[key] : -1
}

string function TF2VR_TitanKeyHint( string key )
{
	int slot = TF2VR_MP_OffhandSlot( key )
	return slot == -1 ? key : "%$rui/tf2vr/arrows/" + TF2VR_MP_TitanGestures()[slot] + "%"
}

// ---------------------------------------------------------------------------
// Titan pose, ported from tf2vr_titan.gnut.  The plugin calls this every frame
// while seated; the stored head pose is what vortex placement and head-aimed
// titan abilities trace from.

void function TF2VR_UpdateTitanPose( int command, vector origin, vector direction, vector angles, vector headOrigin, vector headDirection )
{
	#if SERVER
		array<entity> players = GetPlayerArray()
		pose.player = players.len() > 0 ? players[0] : null
	#else
		pose.player = GetLocalClientPlayer()
	#endif
	pose.origin = origin
	pose.direction = direction
	pose.angles = angles
	pose.headOrigin = headOrigin
	pose.headDirection = headDirection
	#if SERVER
		entity weapon = IsValid( pose.player ) ? pose.player.GetOffhandWeapon( OFFHAND_SPECIAL ) : null
		if ( IsValid( weapon ) && TF2VR_VortexControlled( weapon ) )
		{
			entity sphere = weapon.GetWeaponUtilityEntity()
			if ( IsValid( sphere ) )
			{
				TF2VR_PlaceVortex( sphere )
				weapon.s.vortexBulletEffectCP.SetOrigin( origin )
			}
		}
	#endif
}

bool function TF2VR_VortexControlled( entity weapon )
{
	string name = weapon.GetWeaponClassName()
	return weapon.GetWeaponOwner() == pose.player && ( name == "mp_titanweapon_vortex_shield" || name == "mp_titanweapon_vortex_shield_ion" || name == "mp_titanweapon_heat_shield" )
}

vector function TF2VR_VortexOrigin()
{
	return pose.origin
}

vector function TF2VR_VortexDirection()
{
	return pose.direction
}

void function TF2VR_PlaceVortex( entity sphere )
{
	#if SERVER
		sphere.SetOrigin( pose.origin )
		sphere.SetAbsAngles( pose.angles )
	#endif
}

// The chassis view follows the stick, so head aimed abilities trace from the
// headset.  Before the first TF2VR_UpdateTitanPose there is no head pose yet,
// so fall back to whatever the local player is looking at.
TraceResults function TF2VR_TitanViewTrace()
{
	if ( IsValid( pose.player ) && pose.headDirection != <0, 0, 0> )
		return TraceLine( pose.headOrigin, pose.headOrigin + pose.headDirection * 56756, [ pose.player ], TRACE_MASK_SHOT, TRACE_COLLISION_GROUP_NONE )

	array<entity> players = GetPlayerArray()
	if ( players.len() == 0 )
		return TraceLine( <0, 0, 0>, <0, 0, 1>, [], TRACE_MASK_SHOT, TRACE_COLLISION_GROUP_NONE )

	entity player = players[0]
	vector eye = player.EyePosition()
	return TraceLine( eye, eye + Normalize( player.GetPlayerOrNPCViewVector() ) * 56756, [ player ], TRACE_MASK_SHOT, TRACE_COLLISION_GROUP_NONE )
}

float function TF2VR_TitanViewDot( vector target )
{
	if ( !IsValid( pose.player ) || pose.headDirection == <0, 0, 0> )
		return 1.0
	return DotProduct( Normalize( target - pose.headOrigin ), pose.headDirection )
}

